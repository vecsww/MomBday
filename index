  <script>
    const colors=['#ffd48d','#ff9fbe','#ffffff','#c9a5ff','#ffcfb5'];
    const confetti=document.querySelector('#confetti');
    function celebrate(){
      for(let i=0;i<100;i++){
        const el=document.createElement('i'); el.className='confetto'; el.style.left=Math.random()*100+'vw'; el.style.background=colors[i%colors.length]; el.style.animationDuration=(2.8+Math.random()*2.5)+'s'; el.style.animationDelay=(Math.random()*.55)+'s'; el.style.setProperty('--drift',(Math.random()*260-130)+'px'); el.style.transform='rotate('+Math.random()*360+'deg)'; confetti.appendChild(el); setTimeout(()=>el.remove(),6000);
      }
      for(let i=0;i<14;i++){const heart=document.createElement('span');heart.className='heart';heart.textContent=['♥','♡','✦'][i%3];heart.style.left=(Math.random()*90+5)+'vw';heart.style.color=colors[i%colors.length];heart.style.setProperty('--x',(Math.random()*160-80)+'px');heart.style.animationDelay=(Math.random()*.7)+'s';document.body.appendChild(heart);setTimeout(()=>heart.remove(),4300)}
    }
    const birth = new Date(1977, 8, 26);
    function updateAge(){
      const now = new Date();
      let years = now.getFullYear() - birth.getFullYear();
      const birthdayPassed = now.getMonth() > birth.getMonth() || (now.getMonth() === birth.getMonth() && now.getDate() >= birth.getDate());
      if (!birthdayPassed) years--;
      const totalSeconds = Math.max(0, Math.floor((now - birth) / 1000));
      const totalMinutes = Math.floor(totalSeconds / 60); const totalHours = Math.floor(totalSeconds / 3600); const totalDays = Math.floor(totalSeconds / 86400);
      const totalMonths = years * 12 + now.getMonth() - birth.getMonth() - (now.getDate() < birth.getDate() ? 1 : 0);
      document.querySelector('#age-years').textContent = years;
      document.querySelector('#fact-years').textContent = years;
      document.querySelector('#age-months').textContent = totalMonths;
      document.querySelector('#age-days').textContent = totalDays;
      document.querySelector('#age-hours').textContent = totalHours;
      document.querySelector('#age-minutes').textContent = totalMinutes;
      document.querySelector('#age-seconds').textContent = totalSeconds;
    }
    const messages=['Спасибо, что ты у меня есть.','Ты — мой самый родной человек.','Пусть у тебя будет миллион счастливых дней.','Я всегда рядом, мама.','С любовью, твой Саша.']; let messageIndex=0;
    setInterval(()=>{const el=document.querySelector('#rotating-message'); el.style.opacity=0; setTimeout(()=>{messageIndex=(messageIndex+1)%messages.length; el.textContent=messages[messageIndex]; el.style.opacity=1},400)},4200);
    updateAge(); setInterval(updateAge,1000);
    document.querySelector('#celebrate').addEventListener('click',celebrate);
    document.querySelector('#celebrate-again').addEventListener('click',celebrate);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setTimeout(celebrate,650);
  </script>


</body></html>
